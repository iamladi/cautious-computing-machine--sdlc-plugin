{
    "mcpServers": {
        "context7": {
            "command": "npx",
            "args": ["-y", "@upstash/context7-mcp@latest"]
        },
        "perplexity": {
            "command": "bun",
            "args": ["${CLAUDE_PLUGIN_ROOT}/utils/perplexity-mcp/index.ts"],
            "env": {
              "OPENROUTER_API_KEY": "${OPENROUTER_API_KEY}",
              "OPENROUTER_MODEL": "${OPENROUTER_MODEL:-perplexity/sonar-pro}"
            }
        }
    }
}